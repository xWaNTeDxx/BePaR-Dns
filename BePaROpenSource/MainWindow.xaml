<Window x:Class="BePaR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BePaR" Height="650" Width="400"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        MouseMove="HarekatMoosh_XWaNTeD"
        Loaded="BalaOomadan_XWaNTeD"
        Icon="pack://application:,,,/Assets/logo.png"
        FontFamily="pack://application:,,,/Assets/#Kalameh Bold, pack://application:,,,/Assets/#Kalameh, Tahoma">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Ghab_XWaNTeD" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" />
                    <DoubleAnimation Storyboard.TargetName="Ghab_XWaNTeD" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Glow_XWaNTeD" 
                                     Storyboard.TargetProperty="Opacity" 
                                     From="0.05" To="0.15" Duration="0:0:3">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <Style x:Key="GlassIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#05FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder" Background="{TemplateBinding Background}" CornerRadius="12" BorderThickness="1">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#11FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBorder" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginInputStyle" TargetType="Control">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,0,15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#33FFFFFF" Background="#0AFFFFFF" Margin="0,0,8,0">
                                <Path x:Name="CheckMark" FlowDirection="LeftToRight" Data="M 3 9 L 7 13 L 14 4" Stroke="White" StrokeThickness="2" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#8A2BE2"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#B026FF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Ghab_XWaNTeD" CornerRadius="40" BorderThickness="1.5" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform Y="30"/>
        </Border.RenderTransform>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#33FFFFFF" Offset="0"/>
                <GradientStop Color="#05FFFFFF" Offset="0.5"/>
                <GradientStop Color="#1A8A2BE2" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <RadialGradientBrush x:Name="SpotlightBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="1" RadiusY="1">
                <GradientStop Color="#151522" Offset="0"/>
                <GradientStop Color="#08080C" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid ClipToBounds="True">

            <Ellipse x:Name="Glow_XWaNTeD" Width="600" Height="600" VerticalAlignment="Top" Margin="0,-300,0,0" Opacity="0.1">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8A2BE2" Offset="0"/>
                        <GradientStop Color="#008A2BE2" Offset="0.7"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid x:Name="Dash_XWaNTeD" Visibility="Visible" Panel.ZIndex="1">
                <Border Height="90" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="BalaGereftan_XWaNTeD">
                    <Grid Margin="25,25,25,0" VerticalAlignment="Top" FlowDirection="LeftToRight">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Background="#1A8A2BE2" BorderBrush="#558A2BE2" BorderThickness="1" CornerRadius="10" Padding="12,6,12,6">
                                <TextBlock x:Name="Etebar_XWaNTeD" Text="اشتراک: -- روز" Foreground="#EEEEEE" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GlassIconButtonStyle}" Width="38" Height="38" Click="KoochikKardan_XWaNTeD">
                                <Path Data="M 0 6 L 14 6" Stroke="#888888" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="12" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource GlassIconButtonStyle}" Width="38" Height="38" Margin="12,0,0,0" Click="BastanBarname_XWaNTeD">
                                <Path Data="M 0 0 L 12 12 M 12 0 L 0 12" Stroke="#888888" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid VerticalAlignment="Center" Margin="0,-40,0,0">
                    <Ellipse x:Name="Moje_XWaNTeD" Width="160" Height="160" Stroke="#B026FF" StrokeThickness="3" Opacity="0">
                        <Ellipse.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Ellipse.RenderTransformOrigin>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" x:Name="ShockwaveScale"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="GlowMarkaz_XWaNTeD" Width="350" Height="350" Opacity="0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#708A2BE2" Offset="0"/>
                                <GradientStop Color="#008A2BE2" Offset="0.7"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Ellipse.RenderTransformOrigin>
                        <Ellipse.RenderTransform>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8" x:Name="CenterGlowScale"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Button x:Name="DokmeAsli_XWaNTeD" Width="180" Height="180" Cursor="Hand" Click="ZadanDokmeVasl_XWaNTeD">
                        <Button.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Button.RenderTransformOrigin>
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" x:Name="BozorgiDokme_XWaNTeD"/>
                        </Button.RenderTransform>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ShisheDokme_XWaNTeD" Background="#0AFFFFFF" BorderThickness="1.5" CornerRadius="90" ClipToBounds="True">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#44FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#22FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <Grid>
                                        <Image Source="pack://application:,,,/Assets/logo.png" Width="75" Height="75" RenderOptions.BitmapScalingMode="HighQuality" x:Name="LogoDokme_XWaNTeD" Opacity="0.5">
                                            <Image.RenderTransformOrigin>
                                                <Point X="0.5" Y="0.5"/>
                                            </Image.RenderTransformOrigin>
                                            <Image.RenderTransform>
                                                <RotateTransform Angle="0" x:Name="CharkheshLogo_XWaNTeD"/>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ShisheDokme_XWaNTeD" Property="Background" Value="#15FFFFFF"/>
                                        <Setter TargetName="LogoDokme_XWaNTeD" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <StackPanel VerticalAlignment="Bottom" Margin="25,0,25,35" FlowDirection="RightToLeft">
                    <TextBlock x:Name="MatnVazeiat_XWaNTeD" Text="قطعه حاجی، دکمه رو بزن بریم!" Foreground="#777777" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Border Background="#08FFFFFF" CornerRadius="25" BorderThickness="1" Height="90">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#22FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#11FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <Grid Margin="25,0,25,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="LeftToRight" Orientation="Horizontal">
                                <StackPanel Margin="0,0,15,0" VerticalAlignment="Center">
                                    <TextBlock Text="فاز فعلی برنامـه" Foreground="#777777" FontSize="10" FontWeight="Bold" TextAlignment="Right"/>
                                    <TextBlock x:Name="MatnHalat_XWaNTeD" Text="گیمینگ مشتی" Foreground="#EEEEEE" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" TextAlignment="Right"/>
                                </StackPanel>
                                <Button x:Name="TaghirHalat_XWaNTeD" Width="42" Height="42" Cursor="Hand" Click="ZadanTaghirHalat_XWaNTeD">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ModeBorder" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#11FFFFFF" BorderThickness="1">
                                                <Path x:Name="IconHalat_XWaNTeD" FlowDirection="LeftToRight" Data="M2 12 C2 7 5 4 12 4 C19 4 22 7 22 12 C22 17 19 20 17 20 C15 20 14 17 12 17 C10 17 9 20 7 20 C5 20 2 17 2 12 Z M7 9 L7 15 M4 12 L10 12 M15 10 A1 1 0 1 0 15 10.01 M19 14 A1 1 0 1 0 19 14.01 M19 10 A1 1 0 1 0 19 10.01 M15 14 A1 1 0 1 0 15 14.01" Stroke="#B026FF" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ModeBorder" Property="Background" Value="#15FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="14" Background="#0AFFFFFF" BorderBrush="#11FFFFFF" BorderThickness="1">
                                    <Path x:Name="IconServer_XWaNTeD" FlowDirection="LeftToRight" Data="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z M2 12H22 M12 2C14.5013 4.73835 15.9228 8.29203 16 12C15.9228 15.708 14.5013 19.2616 12 22C9.49872 19.2616 8.07725 15.708 8 12C8.07725 8.29203 9.49872 4.73835 12 2Z" Stroke="#555555" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="سرور اتصال ما" Foreground="#777777" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="MatnServer_XWaNTeD" Text="فعلا تو گاراژیم" Foreground="#EEEEEE" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Border x:Name="SafheVorood_XWaNTeD" CornerRadius="40" Background="#F2050508" Visibility="Visible" Panel.ZIndex="100" MouseLeftButtonDown="BalaGereftan_XWaNTeD">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#448A2BE2" Offset="0"/>
                        <GradientStop Color="#11FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Border Height="90" VerticalAlignment="Top" Background="Transparent">
                        <Grid Margin="25,25,25,0" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassIconButtonStyle}" Width="38" Height="38" Click="KoochikKardan_XWaNTeD">
                                    <Path Data="M 0 6 L 14 6" Stroke="#888888" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="12" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource GlassIconButtonStyle}" Width="38" Height="38" Margin="12,0,0,0" Click="BastanBarname_XWaNTeD">
                                    <Path Data="M 0 0 L 12 12 M 12 0 L 0 12" Stroke="#888888" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                        <Border Width="85" Height="85" Background="#1A8A2BE2" BorderBrush="#558A2BE2" BorderThickness="1.5" CornerRadius="45" Margin="0,0,0,20">
                            <Image Source="pack://application:,,,/Assets/logo.png" Width="45" Height="45" Stretch="Uniform" Opacity="0.9"/>
                        </Border>

                        <TextBlock Text="بِــپَــر نتـورک" Foreground="#FFFFFF" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="ورود امن و اتوماتیک" Foreground="#888888" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <TextBlock x:Name="KhatayeVorood_XWaNTeD" Text="" Foreground="#FF4444" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" Visibility="Collapsed"/>

                        <Border Background="#0AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,25">
                            <TextBlock Text="داشِ گلم، واسه اینکه امنیتت فول باشه و هی نخوای یوزر پسوردت رو اینجا تایپ کنی، دکمه پایین رو بکوب برو تو سایت تایید کن و خودکار برگرد همینجا. یه کلیک فاصله داری تا وصل شی!" 
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"/>
                        </Border>

                        <Button x:Name="DokmeVorood_XWaNTeD" Height="48" Cursor="Hand" Click="ZadanDokmeVorood_XWaNTeD">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="LoginBtnBorder" CornerRadius="14" Background="#8A2BE2">
                                        <TextBlock x:Name="LoginBtnText" Text="بزن بریم تو سایت تایید کنیم" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LoginBtnBorder" Property="Background" Value="#B026FF"/>
                                            <Setter TargetName="LoginBtnBorder" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#B026FF" BlurRadius="15" ShadowDepth="0"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SafheUpdate_XWaNTeD" CornerRadius="40" Background="#F2050508" Visibility="Collapsed" Panel.ZIndex="200" MouseLeftButtonDown="BalaGereftan_XWaNTeD">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#448A2BE2" Offset="0"/>
                        <GradientStop Color="#11FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="280">
                        <Border Width="85" Height="85" Background="#1A8A2BE2" BorderBrush="#558A2BE2" BorderThickness="1.5" CornerRadius="45" Margin="0,0,0,20">
                            <Path Data="M 12 4 L 12 16 M 8 12 L 12 16 L 16 12 M 4 20 L 20 20" Stroke="#B026FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="پشمام آپدیت اومد!" Foreground="#FFFFFF" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock x:Name="VazeiatUpdate_XWaNTeD" Text="داش وایسا دارم دانلودش میکنم..." Foreground="#888888" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>